direction: right

# Mobile App Architecture
mobile: {
  label: "Mobile App\n(React Native + Expo)"
  
  ui_layer: {
    label: "UI Layer"
    
    screens: {
      label: "Screens"
      home: "Home"
      learn: "Learn"
      progress: "Progress"
      community: "Community"
      profile: "Profile"
      admin: "Admin"
    }
    
    components: {
      label: "Components"
      screen_container: "ScreenContainer"
      quiz_card: "QuizCard"
      ugc_card: "UGCCard"
      comment_modal: "CommentModal"
    }
  }
  
  state_layer: {
    label: "State & Hooks"
    
    hooks: {
      label: "Custom Hooks"
      use_colors: "useColors()"
      use_auth: "useAuth()"
      use_local_storage: "AsyncStorage"
    }
  }
  
  business_logic: {
    label: "Business Logic"
    
    handlers: {
      label: "Handlers"
      quiz_handler: "QuizHandler"
      essay_feedback: "EssayFeedback"
      ugc_handler: "UGCHandler"
      social_system: "SocialSystem"
    }
    
    data: {
      label: "Data"
      dummy_data: "DummyData"
      finstudy_data: "FinStudyData"
    }
  }
}

# Backend Services
backend: {
  label: "Backend Services"
  
  api_layer: {
    label: "API Layer (tRPC)"
    
    routes: {
      label: "Routes"
      quiz_api: "Quiz API"
      user_api: "User API"
      content_api: "Content API"
      social_api: "Social API"
    }
  }
  
  core_services: {
    label: "Core Services"
    
    services: {
      label: "Services"
      gemini_client: "Gemini Client"
      auth_service: "Auth Service"
      db_service: "Database Service"
      storage_service: "Storage Service"
    }
  }
  
  data_layer: {
    label: "Data Layer"
    
    database: {
      label: "Database (MySQL)"
      tables: {
        users: "Users"
        quizzes: "Quizzes"
        articles: "Articles"
        ugc_content: "UGC Content"
        comments: "Comments"
        social_data: "Social Data"
      }
    }
  }
}

# External Services
external: {
  label: "External Services"
  
  ai_services: {
    label: "AI Services"
    gemini: "Gemini API\n(LLM Analysis)"
  }
  
  storage: {
    label: "Storage"
    s3: "S3 Storage\n(Images/Videos)"
  }
  
  auth: {
    label: "Authentication"
    oauth: "OAuth 2.0"
  }
}

# Connections
mobile.ui_layer -> mobile.state_layer: "State Management"
mobile.state_layer -> mobile.business_logic: "Data Flow"
mobile.business_logic -> backend.api_layer: "API Calls (tRPC)"

backend.api_layer -> backend.core_services: "Service Layer"
backend.core_services -> backend.data_layer: "Query/Mutation"

backend.core_services -> external.ai_services: "AI Analysis"
backend.core_services -> external.storage: "File Upload"
backend.api_layer -> external.auth: "Authentication"

# Data Flow
mobile.business_logic.handlers.essay_feedback -> external.ai_services.gemini: "Essay Analysis"
mobile.business_logic.handlers.ugc_handler -> backend.data_layer.database.tables.ugc_content: "UGC CRUD"
mobile.business_logic.handlers.social_system -> backend.data_layer.database.tables.social_data: "Social Data"

# Local Storage
mobile.state_layer.hooks.use_local_storage -> mobile.business_logic.data: "Local Cache"
